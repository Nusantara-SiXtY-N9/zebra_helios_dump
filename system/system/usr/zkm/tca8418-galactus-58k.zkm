lock {
	blue:          'toggle_oneshot_and_lock'
	orange:        'toggle_none'
	gray:          'toggle_none'
	diamond:       'toggle_oneshot_and_lock'
	shift:         'toggle_oneshot_and_lock'
	alt:           'toggle_oneshot'
	ctrl:          'toggle_oneshot'
	capslock:      'toggle_lock'
}
diamond {
	matrix:        '3x3'
	order:         '1,2,3,4,5,6,7,8,9'
}

key 1 {
	label:          '1'
	base:           '1'
	diamond:        '|'
}
key 2 {
	label:          '2'
	base:           '2'
	diamond:        '['
}
key 3 {
	label:          '3'
	base:           '3'
	diamond:        ']'
}
key 4 {
	label:          '4'
	base:           '4'
	diamond:        '£'
}
key 5 {
	label:          '5'
	base:           '5'
	diamond:        ':'
}
key 6 {
	label:          '6'
	base:           '6'
	diamond:        '€'
}
key 7 {
	label:          '7'
	base:           '7'
	diamond:        '~'
}
key 8 {
	label:          '8'
	base:           '8'
	diamond:        '@'
}
key 9 {
	label:          '9'
	base:           '9'
	diamond:        '_'
}
key 0 {
	label:          '0'
	base:           '0'
}
# A-L need to generate FN for blue table function key values
key a {
	label:          'A'
	base:           'a'
	blue:           'FUNCTION+f1'
}
