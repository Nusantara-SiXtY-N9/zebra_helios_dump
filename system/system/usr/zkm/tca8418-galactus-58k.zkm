}
key space {
	label:         'SPACE'
	base:          'space'
}
key backspace {
	label:         'BACKSPACE'
	base:          'del'
	blue:          'forward_del'
}
key esc {
	label:          'ESC'
	base:           'escape'
}
key tab {
	label:          'TAB'
	base:           'tab'
}
key left {
	label:          'LEFT'
	base:           'dpad_left'
}
key down {
	label:          'DOWN'
	base:           'dpad_down'
