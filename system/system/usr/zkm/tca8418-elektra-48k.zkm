lock {
	blue:           'toggle_oneshot_and_lock'
	orange:         'toggle_lock'
	gray:           'toggle_none'
	shift:          'toggle_oneshot_and_lock'
	alt:            'toggle_oneshot'
	ctrl:           'toggle_oneshot'
	diamond:        'toggle_oneshot_and_lock'
}
diamond {
	matrix:         '3x3'
	order:          '7,8,9,4,5,6,1,2,3'
}
key 1 {
	label:          '1'
	base:           '1'
	diamond:        '+'
}
key 2 {
	label:          '2'
	base:           '2'
	orange:         'dpad_down'
	diamond:        '-'
}
key 3 {
	label:          '3'
	base:           '3'
	diamond:        '@'
}
key 4 {
	label:          '4'
	base:           '4'
	orange:         'dpad_left'
	diamond:        '/'
}
key 5 {
	label:          '5'
	base:           '5'
	diamond:        '#'
}
key 6 {
	label:          '6'
	base:           '6'
	orange:         'dpad_right'
	diamond:        ':'
}
key 7 {
	label:          '7'
	base:           '7'
	diamond:        ';'
}
key 8 {
	label:          '8'
	base:           '8'
	orange:         'dpad_up'
	diamond:        '~'
}
key 9 {
	label:          '9'
	base:           '9'
	diamond:        '!'
}
key 0 {
	label:          '0'
	base:           '0'
}
