	orange:         'p,q,r,s'
	diamond:        ';'
}
key 8 {
	label:          '8'
	base:           '8'
	orange:         't,u,v'
	diamond:        '~'
}
key 9 {
	label:          '9'
	base:           '9'
	orange:         'w,x,y,z'
	diamond:        '!'
}
key dot {
	label:          'DOT'
	base:           'period'
	orange:         'comma'
}
