lock {
	blue:           'toggle_none'
	orange:         'toggle_lock'
	gray:           'toggle_none'
	shift:          'toggle_oneshot_and_lock'
	alt:            'toggle_oneshot'
	ctrl:           'toggle_oneshot'
	diamond:        'toggle_oneshot_and_lock'
}
diamond {
	matrix:         '3x3'
	order:          '1,2,3,4,5,6,7,8,9'
}
key 1 {
	label:          '1'
	base:           '1'
	diamond:        '+'
}
key 2 {
	label:          '2'
	base:           '2'
	orange:         'a,b,c'
	diamond:        '-'
}
key 3 {
	label:          '3'
	base:           '3'
	orange:         'd,e,f'
	diamond:        '@'
}
key 4 {
	label:          '4'
	base:           '4'
	orange:         'g,h,i'
	diamond:        '/'
}
key 5 {
	label:          '5'
	base:           '5'
	orange:         'j,k,l'
	diamond:        '#'
}
key 6 {
	label:          '6'
	base:           '6'
	orange:         'm,n,o'
	diamond:        ':'
}
key 7 {
	label:          '7'
