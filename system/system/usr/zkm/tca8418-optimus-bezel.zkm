lock {
    blue:          'toggle_oneshot_and_lock'
    orange:        'toggle_none'
    gray:          'toggle_none'
    shift:         'toggle_none'
    alt:           'toggle_none'
    ctrl:          'toggle_none'
    diamond:       'toggle_oneshot_and_lock'
}

diamond {
    matrix:        '3x12'
    order:         'd00,d01,d02,d03,d04,d05,d06,d07,d08,d09,d0a,d0b,d10,d11,d12,d13,d14,d15,d16,d17,d18,d19,d1a,d1b,d20,d21,d22,d23,d24,d25,d26,d27,d28,d29,d2a,d2b'
    sip:           '1'
    movekeys:      '2,0; 2,11'
}

key f1 {
    label:          'M1'
    base:           'f1'
    blue:           'f7'
}
key f2 {
    label:          'M2'
    base:           'f2'
    blue:           'f8'
}
