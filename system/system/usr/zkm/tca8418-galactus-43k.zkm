lock {
	blue:          'toggle_oneshot_and_lock'
	orange:        'toggle_oneshot_and_lock'
	gray:          'toggle_none'
	diamond:       'toggle_oneshot_and_lock'
	shift:         'toggle_oneshot_and_lock'
	alt:           'toggle_oneshot'
	ctrl:          'toggle_oneshot'
	capslock:      'toggle_lock'
}
diamond {
	matrix:        '3x3'
	order:         '7,8,9,4,5,6,1,2,3'
}
key p1 {
	label:          'P1'
	wakeup:         'false'
	base:           'BUTTON_L2'
}
key p2 {
	label:          'P2'
	base:           'symbol_trigger_1'
	default_base:   'BUTTON_L1'
}
key left {
	label:          'LEFT'
	base:           'dpad_left'
}
key right {
	label:          'RIGHT'
	base:           'dpad_right'
}
key down {
	label:          'DOWN'
	base:           'dpad_down'
}
key up {
	label:          'UP'
	base:           'dpad_up'
}
key esc {
	label:          'ESC'
	base:           'escape'
}
key ctrl {
	label:         'CTRL'
	base:          'symbol_ctrl'
}
key alt {
	label:         'ALT'
	base:          'symbol_alt'
}
key blue {
	label:         'BLUE'
	base:          'symbol_blue'
}
key orange {
	label:         'ORANGE'
	base:          'symbol_orange'
}

