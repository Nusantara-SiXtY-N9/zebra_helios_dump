key p1-btn {
	label:          'P1'
	hard_wakeup:    'true'
	base:           'volume_down'
}
key p2-btn {
	label:          'P2'
	hard_wakeup:    'true'
	base:           'volume_up'
}
key p3-btn {
	label:          'P3'
	hard_wakeup:    'true'
	base:           'enter'
}
