}
key hw_trigger_l {
	label:          'LEFT_EXTERNAL_TRIGGER'
	hard_wakeup:    'true'
	base:           'SYMBOL_TRIGGER_7'
}
key remote_trigger_1 {
	label:          'BLUETOOTH_REMOTE_TRIGGER_1'
