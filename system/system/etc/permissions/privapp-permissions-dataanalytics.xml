<!--
This XML file declares which signature|privileged permissions should be
granted to privileged applications on QTI devices.
It allows additional grants on top of privapp-permissions-platform.xml
-->

<permissions>

    <privapp-permissions package="com.symbol.dataanalytics">
        <permission name="android.permission.READ_PRIVILEGED_PHONE_STATE"/>
        <permission name="android.permission.WRITE_MEDIA_STORAGE"/>
        <permission name="com.symbol.permission.ENTERPRISE"/>
        <permission name="android.permission.SCHEDULE_EXACT_ALARM"/>
    </privapp-permissions>

    <privapp-permissions package="com.symbol.dataanalytics.dca">
        <permission name="android.permission.READ_PRIVILEGED_PHONE_STATE" />
        <permission name="android.permission.FOREGROUND_SERVICE" />
        <permission name="android.permission.ACTIVITY_RECOGNITION"/>
        <permission name="android.permission.PACKAGE_USAGE_STATS"/>
        <permission name="android.permission.WRITE_MEDIA_STORAGE"/>
        <permission name="android.permission.BLUETOOTH_PRIVILEGED"/>
        <permission name="com.symbol.permission.ENTERPRISE"/>
    </privapp-permissions>

    <privapp-permissions package="com.symbol.dataanalytics.systemhelper">
        <permission name="android.permission.DUMP"/>
        <permission name="android.permission.BATTERY_STATS"/>
    </privapp-permissions>

    <privapp-permissions package="com.symbol.mxmf.csp.analyticsmgr">
        <permission name="com.symbol.permission.ENTERPRISE"/>
    </privapp-permissions>

</permissions>
