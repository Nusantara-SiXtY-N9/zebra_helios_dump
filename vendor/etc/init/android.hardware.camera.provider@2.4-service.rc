service vendor.camera-provider-2-4 /vendor/bin/hw/android.hardware.camera.provider@2.4-service
    interface android.hardware.camera.provider@2.4::ICameraProvider legacy/0
    class hal
    user cameraserver
    group audio camera input drmrpc
    ioprio rt 4
    capabilities SYS_NICE
    task_profiles CameraServiceCapacity HighPerformance

#BSPA-220062: disable unused services for 2GB to reduce the memory usage
on property:sys.boot_completed=1 && property:ro.config.device.memsize=4 && property:ro.config.device.camera0=0 && property:ro.config.device.camera1=0
     stop vendor.camera-provider-2-4
