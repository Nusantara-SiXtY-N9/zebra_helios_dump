     start cnss_diag

#Disable fw logs in userdebug with low memory build
on property:vendor.wifi.fusionloader.fwloglowmemdisable=1 && property:ro.build.type=userdebug
     stop cnss_diag

service cnss_diag /system/vendor/bin/cnss_diag -q -f -t HELIUM
   class main
   user system
   group system wifi inet sdcard_rw media_rw diag
   disabled
   oneshot

service dcvs-sh /vendor/bin/init.qti.dcvs.sh
    class late_start
    user root
    group root system
    disabled
    oneshot

on property:vendor.dcvs.prop=1
   start dcvs-sh


#service ppd /system/vendor/bin/mm-pp-dpps
#    class late_start
#    user system
#    group system graphics
#    socket pps stream 0660 system system
#    disabled

on property:init.svc.surfaceflinger=stopped
    stop ppd

on property:init.svc.surfaceflinger=running
    start ppd

on property:init.svc.surfaceflinger=restarting
    stop ppd

on property:init.svc.zygote=stopped
    stop health-hal-2-1
    stop ppd


on property:init.svc.zygote=running
    start health-hal-2-1
    start ppd

on property:init.svc.zygote=restarting
    stop health-hal-2-1
    stop ppd

on init
   start vendor_charger

on charger
    start qcom-post-boot
    start vendor.hvdcp_opti
    setprop sys.usb.configfs 1
    start vendor.power_off_alarm

service vendor_charger /vendor/bin/vendor_charger
    class core
    user root
    group root
    oneshot
    disabled

#
#service nqs /system/bin/nqs
#    class late_start
#    socket nqs_qsb_comm stream 660 system system
#    user system
#    group drmrpc
#
#service adsprpcd /system/vendor/bin/adsprpcd
#   class main
#   user media
#   group media
#
##Start picture quality tuning service
#service vqttoolservice /system/bin/vqttoolservice
#    class late_start
#    socket vqtss stream 0660 system system
#    user system
#    group system

service seempd /system/bin/seempd
    class late_start
    user system
    group system sdcard_rw
    socket seempdw dgram 0666 system system

service vendor.tlocd /vendor/bin/tloc_daemon
    class late_start
    user system
    group drmrpc gps net_raw

service vendor.hvdcp_opti /system/vendor/bin/hvdcp_opti
     class main
     user root
     group system wakelock

service smcinvoked /system/bin/smcinvoked
   class main
   user system
   group system

on property:ro.boottime.hbtp=*
    start touch_ver

# Get touch version
service touch_ver /vendor/bin/touch_ver.sh
    class late_start
    user root
    group root
    oneshot
    disabled

on property:vold.decrypt=trigger_restart_framework && property:sys.boot_completed=1 && property:persist.vendor.sys.raven_fw_enabler=*
    chmod 0664 /sys/bus/i2c/devices/4-0024/firmware/cyttsp5_fw_manual_upgrade/loading
    chown system root /sys/bus/i2c/devices/4-0024/firmware/cyttsp5_fw_manual_upgrade/loading
    chmod 0664 /sys/bus/i2c/devices/4-0024/firmware/cyttsp5_fw_manual_upgrade/data
    chown system root /sys/bus/i2c/devices/4-0024/firmware/cyttsp5_fw_manual_upgrade/data

# Atmel touch
service touch_config /vendor/bin/touch_config.sh
    class main
    user root
    group root
    disabled
    oneshot

# Firebird undock/dock
service dp_monitor_reset /vendor/bin/dp_monitor_reset.sh
    class main
    user root
    group root
    disabled
    oneshot

on property:vold.decrypt=trigger_restart_framework && property:sys.boot_completed=1 && property:persist.sys.touch_mode=*
   wait /sys/bus/i2c/devices/4-004b/switch_cfg
   start touch_config

on property:ro.config.device.firebird=true && property:persist.vendor.monitor.reset=*
    start dp_monitor_reset

on property:ro.config.device.wwan_device=true
    start gnss_service

# WT6300 Keypad

service keypad_link /system/vendor/bin/wt6kkbdattach
    class core
    user root
    group root
    disabled

# when keypad is connected, change owner to root for io controlling
on property:persist.sys.ext_keypad=1
    chown root root /dev/ttyHS1
    stop keypad_link
    start keypad_link

on property:persist.sys.ext_keypad=0
    chown system system /dev/ttyHS1
    stop keypad_link

#For secure start-up
on property:ro.config.device.iomux=1
    start ext_keypad

service ext_keypad /vendor/bin/ext_keypad.sh
    class core
    user root
    group root
    disabled
    oneshot

on property:ro.symbol.set_ext_keypad=1
    chown root root /dev/ttyHS1
    stop keypad_link
    start keypad_link

#FBE
on property:ro.crypto.type=file && property:sys.boot_completed=1 && property:persist.sys.touch_mode=*
   wait /sys/bus/i2c/devices/4-004b/switch_cfg
   start touch_config

on property:ro.config.device.encryption=file && property:sys.boot_completed=1 && property:persist.vendor.sys.raven_fw_enabler=*
    chmod 0664 /sys/bus/i2c/devices/4-0024/firmware/cyttsp5_fw_manual_upgrade/loading
    chown system root /sys/bus/i2c/devices/4-0024/firmware/cyttsp5_fw_manual_upgrade/loading
    chmod 0664 /sys/bus/i2c/devices/4-0024/firmware/cyttsp5_fw_manual_upgrade/data
    chown system root /sys/bus/i2c/devices/4-0024/firmware/cyttsp5_fw_manual_upgrade/data

#Touch Calibration
on property:sys.boot_completed=1
    setprop sys.touch.calibration.file /enterprise/device/settings/touch_calibration.txt
    setprop sys.touch.calibration.sysfs /sys/bus/i2c/devices/4-0049/calibration
    chown system system /sys/bus/i2c/devices/4-0049/calibration
    copy /enterprise/device/settings/touch_calibration.txt /sys/bus/i2c/devices/4-0049/calibration

on property:sys.boot_completed=1
   chmod 666  /sys/power/batt_extras/percent_decommission_threshold
   chmod 666  /sys/power/batt_extras/batteryusage_decommission_threshold
   chmod 666  /sys/power/batt_extras/battery_low_adj

# enable SSR.
on early-init && property:ro.build.type=user
    chown system system /sys/bus/msm_subsys/devices/subsys0/restart_level
    chmod 0644 /sys/bus/msm_subsys/devices/subsys0/restart_level
    write /sys/bus/msm_subsys/devices/subsys0/restart_level related
    setprop persist.sys.ssr.restart_level ALL_ENABLE
    write /sys/module/subsystem_restart/parameters/max_history_time 1800
    write /sys/module/subsystem_restart/parameters/max_restarts 5

on property:ro.vendor.symbol.qcom.download=1
    write /sys/module/msm_poweroff/parameters/download_mode 1

# enable SSR.
on early-init && property:ro.build.type=user
   setprop persist.vendor.ssr.restart_level modem

on property:ro.vendor.symbol.qcom.download=1
   setprop persist.vendor.ssr.restart_level modem

on property:sys.boot_completed=1
   setprop ro.setupwizard.mode "OPTIONAL"

#Buckboost
on property:persist.vendor.buckboost.alwayson=1
    write /sys/battery_swap/enable_buck_boost 1

on property:persist.vendor.buckboost.alwayson=0
    write /sys/battery_swap/enable_buck_boost 0

#ET51 LAN ON-Semi AR1335 Foxconn rear camera
on property:ro.config.device.model=5000 && property:ro.config.device.camera0=32 && property:persist.vendor.camera.exif.rotation=on
    setprop persist.vendor.camera.exif.rotation off
    setprop persist.vendor.camera.lib2d.rotation on

#ET56 WAN ON-Semi AR1335 Foxconn rear camera
on property:ro.config.device.model=5010 && property:ro.config.device.camera0=32 && property:persist.vendor.camera.exif.rotation=on
    setprop persist.vendor.camera.exif.rotation off
    setprop persist.vendor.camera.lib2d.rotation on


service wacom_version /vendor/bin/wacom_version
    class main
    group root
    user root
    disabled
    oneshot

on property:sys.boot_completed=1
    start wacom_version

on property:ro.build.user=android-build
    setprop media.settings.xml /vendor/etc/gsi_media_profiles_V1_0.xml

# BSPA-98217 [Galactus] Disable 720x480 within media controller library and media profiles xml for display 800x480
# BSPA-101764 [Galactus] Some options are missing from the video quality menu
# BSPA-94337 [Raven] GSI CtsCameraTestCases Fail
on property:ro.config.device.display=505 && property:ro.build.user=android-build && property:init.svc.vold=running
    setprop media.settings.xml /vendor/etc/media_profiles_vendor_wo720x480.xml

on property:ro.config.device.display=1000 && property:ro.build.user=android-build && property:init.svc.vold=running
    setprop media.settings.xml /vendor/etc/media_profiles_vendor_wo720x480.xml

on property:ro.config.device.display=1001 && property:ro.build.user=android-build && property:init.svc.vold=running
    setprop media.settings.xml /vendor/etc/media_profiles_vendor_wo720x480.xml

on property:ro.config.device.display=1002 && property:ro.build.user=android-build && property:init.svc.vold=running
    setprop media.settings.xml /vendor/etc/media_profiles_vendor_wo720x480.xml

# SAR Sensor Daemon
on property:ro.config.device.sar=2
    start sardaemon

service sardaemon /vendor/bin/sardaemon
    class late_start
    user root
    group root
    oneshot
    disabled

#START Wifi mac address loading
service vendor.loadWifi_mac /vendor/bin/sh /vendor/bin/loadWifimac.sh
    class late_start
    user root
    group root
    oneshot
    disabled
on post-fs
    start vendor.loadWifi_mac
#END Wifi mac address loading

#hw_disable for GSI Image
on property:sys.boot_completed=1 && property:ro.product.system.device=generic_arm64
    start hw_disable

on property:sys.boot_completed=1 && property:ro.product.system.device=generic_arm64_ab
    start hw_disable

service hw_disable /vendor/bin/hw_disable
    class core
    user root
    group root
    oneshot
    disabled

on property:persist.vendor.startcfa=1
   start beep_cfa

service beep_cfa /system/bin/beep_cfa
    class core
    user root
    group root
    oneshot
    disabled


#CTS on GSI fix
on property:ro.build.user=android-build && property:init.svc.vold=running
    setprop vendor.vidc.enc.disable.pq true

on boot && property:ro.build.type=user
    enable vendor.qcom-usb_user-sh

# BSPA-177217 workaround for USB preference disappeared after reset by package
on property:sys.boot_completed=1 && property:ro.build.type=user
    setprop sys.usb.config ${sys.usb.config}

service vendor.qcom-usb_user-sh /vendor/bin/init.qcom.usb_user.sh
    class core
    user root
    oneshot
    disabled

on property:ro.build.type=user && property:ro.symbol.test.automation=1 && property:persist.vendor.usb.config=none
   setprop persist.vendor.usb.config adb

on load_persist_props_action && property:ro.build.type=user && property:ro.symbol.test.automation=1
   stop adbd
   setprop persist.vendor.usb.config adb

on load_persist_props_action && property:ro.build.type=user && property:ro.symbol.test.automation=0
   setprop persist.vendor.usb.config none
   setprop persist.sys.usb.config mtp

on boot && property:ro.symbol.test.wifiautomation=1
   setprop service.adb.tcp.port 5555

on load_persist_props_action && property:ro.vendor.symbol.qcom.diag=1
   setprop persist.vendor.usb.config diag,serial_cdev,rmnet,adb

on property:persist.buckboost.alwayson=1
    write /sys/battery_swap/enable_buck_boost 1

on property:persist.buckboost.alwayson=0
    write /sys/battery_swap/enable_buck_boost 0

service sub_system_restart /vendor/bin/subsys_ssr.sh modem related
    class core
    user root
    oneshot
    disabled

on property:sys.boot_completed=1 && property:persist.vendor.sys.modem_ssr=1 && property:ro.build.type=user
    start sub_system_restart

service secure_wakelock_acquire /vendor/bin/secure_wakelock.sh acquire
    class core
    user root
    oneshot
    disabled

service secure_wakelock_release /vendor/bin/secure_wakelock.sh release
    class core
    user root
    oneshot
    disabled

on property:vold.decrypt=trigger_restart_min_framework && property:sys.boot_completed=1
    start secure_wakelock_acquire

on property:service.bootanim.exit=1 && property:sys.secure_lock=release
    start secure_wakelock_release

# USB Mode for MtFuji
on property:persist.sys.usb.sharp_usb_mode=0 && property:ro.config.device.model=2220
   write /sys/devices/platform/soc/a800000.ssusb/mode none

on property:persist.sys.usb.sharp_usb_mode=1 && property:ro.config.device.model=2220
   write /sys/devices/platform/soc/a800000.ssusb/mode host

on property:persist.sys.usb.sharp_usb_mode=2 && property:ro.config.device.model=2220
   write /sys/devices/platform/soc/a800000.ssusb/mode peripheral

# Set usb mode to none for battery swap
on property:persist.sys.usb.reset_usb_none=1 && property:ro.config.device.model=2220
   write /sys/devices/platform/soc/a800000.ssusb/mode none

# Early emounting enterprise partition to read the SDK version from DeviceManifest_V2.xml file for resetting data while transitioning from FDE TO FBE.
on early-fs && property:ro.boot.cc_state=1 && property:ro.boot.cc_supported=1
   wait /dev/block/bootdevice/by-name/enterprise
   mount ext4 /dev/block/bootdevice/by-name/enterprise /zebra_meta rw nosuid nodev noatime barrier=1

#Enable Camera Setting to Assist AR1337 MMS Tuning
#Lightning
on property:ro.config.device.model=5700 && property:ro.config.device.camera0=128
  setprop persist.vendor.camera.af_hj.enable 1
  setprop persist.vendor.camera.cds true
on property:ro.config.device.model=5200 && property:ro.config.device.camera0=128
    setprop persist.vendor.camera.af_hj.enable 1
    setprop persist.vendor.camera.cds true
#Thunder
on property:ro.config.device.model=7700 && property:ro.config.device.camera0=128
  setprop persist.vendor.camera.af_hj.enable 1
  setprop persist.vendor.camera.cds true
on property:ro.config.device.model=7200 && property:ro.config.device.camera0=128
    setprop persist.vendor.camera.af_hj.enable 1
    setprop persist.vendor.camera.cds true
#Simba
on property:ro.config.device.model=5510 && property:ro.config.device.camera0=128
  setprop persist.vendor.camera.af_hj.enable 1
  setprop persist.vendor.camera.cds true
on property:ro.config.device.model=5500 && property:ro.config.device.camera0=128
    setprop persist.vendor.camera.af_hj.enable 1
    setprop persist.vendor.camera.cds true
#Mufasa and Aslan
on property:ro.config.device.model=5710 && property:ro.config.device.camera0=128
  setprop persist.vendor.camera.af_hj.enable 1
  setprop persist.vendor.camera.cds true
on property:ro.config.device.model=5210 && property:ro.config.device.camera0=128
    setprop persist.vendor.camera.af_hj.enable 1
    setprop persist.vendor.camera.cds true
on property:ro.config.device.model=5220 && property:ro.config.device.camera0=128
    setprop persist.vendor.camera.af_hj.enable 1
    setprop persist.vendor.camera.cds true
#Firebird
on property:ro.config.device.model=5000 && property:ro.config.device.camera0=128
    setprop persist.vendor.camera.pdafcoef 25.83
on property:ro.config.device.model=5010 && property:ro.config.device.camera0=128
    setprop persist.vendor.camera.pdafcoef 25.83
#Galactus
on property:ro.config.device.model=9300 && property:ro.config.device.camera0=128
    setprop persist.vendor.camera.pdafcoef 25.83
on property:sys.gc_settings=1
    start force_GC

service force_GC /vendor/bin/force_GC.sh
    class late_start
    user root
    group root
    oneshot
    disabled

service wifi_governor /vendor/bin/wifi_governor
    class core
    user root
    group root
    oneshot
    disabled

on post-fs-data
   start wifi_governor

# Early emounting enterprise partition to read the SDK version from DeviceManifest_V2.xml file for resetting data while transitioning from FDE TO FBE.
on early-fs && property:ro.boot.cc_state=0
   wait /dev/block/bootdevice/by-name/enterprise
   mount ext4 /dev/block/bootdevice/by-name/enterprise /enterprise rw nosuid nodev noatime barrier=1
   chown system system /enterprise/
   chmod 0775 /enterprise/

on property:fusion.restart_wifi=1
    exec u:r:shell:s0 shell shell -- /system/bin/sh /vendor/bin/fusion_restart_wifi.sh
    setprop fusion.restart_wifi 0


# Add for Dynamic Lock Screen Rotation Support
on property:ro.config.device.enable_lockscreen_rotation=1
    setprop lockscreen.rot_override true

# SPR-53070 Water droplet notification is not getting.
on property:sys.boot_completed=1
    write /sys/bus/i2c/devices/1-0028/fusb251_reset 1

