import /vendor/etc/init/hw/init.helios.usb.configfs.rc
import /vendor/etc/init/hw/init.keyboards.rc
import /vendor/etc/init/hw/init.helios.odm.rc
import /vendor/etc/init/hw/nofusion_driverload.rc

on early-init
    exec u:r:vendor_modprobe:s0 -- /vendor/bin/modprobe -a -d /vendor/lib/modules audio_apr audio_wglink audio_adsp_loader audio_q6_pdr audio_q6_notifier audio_q6 audio_usf audio_native audio_pinctrl_wcd audio_pinctrl_lpi audio_swr audio_platform audio_hdmi audio_wcd_spi audio_stub audio_digital_cdc audio_analog_cdc audio_msm_sdw audio_wcd_cpe audio_cpe_lsm audio_wcd9335 audio_machine_sdm660 audio_wcd934x audio_mbhc audio_wcd9xxx audio_wcd_core audio_helios_ptt
    mkdir /firmware 0771 system system
    mkdir /bt_firmware 0771 system system
    mkdir /dsp 0771 media media
    mkdir /enterprise 0771 system system
    mkdir /factory 0771 root system
    # persist partition mounting
    mkdir /mnt/vendor/persist/ 0700 system system
    chmod 0771 /mnt/vendor/persist
    wait /dev/block/platform/soc/${ro.boot.bootdevice}/by-name/persist
    mount ext4 /dev/block/platform/soc/${ro.boot.bootdevice}/by-name/persist /mnt/vendor/persist  nosuid nodev noatime barrier=1
    restorecon_recursive --force /mnt/vendor/persist

on init
    write /dev/stune/foreground/schedtune.sched_boost_no_override 1
    write /dev/stune/top-app/schedtune.sched_boost_no_override 1
    write /dev/stune/schedtune.colocate 0
    write /dev/stune/background/schedtune.colocate 0
    write /dev/stune/system-background/schedtune.colocate 0
    write /dev/stune/foreground/schedtune.colocate 0
    write /dev/stune/top-app/schedtune.colocate 1
    wait /dev/block/platform/soc/${ro.boot.bootdevice}
    symlink /dev/block/platform/soc/${ro.boot.bootdevice} /dev/block/bootdevice
    start vendor.qseecomd
    start keymaster-4-0
    #mkdir /mnt/vendor/persist/ 0700 system system
    #chmod 0771 /mnt/vendor/persist
    #wait /dev/block/platform/soc/${ro.boot.bootdevice}/by-name/persist
    #mount ext4 /dev/block/platform/soc/${ro.boot.bootdevice}/by-name/persist /mnt/vendor/persist  nosuid nodev noatime barrier=1
    #restorecon_recursive /mnt/vendor/persist

on init && property:ro.build.type=user
    restorecon_recursive --force /mnt/vendor/persist

on init && property:ro.build.type=userdebug
    umount /mnt/vendor/persist
    wait /dev/block/platform/soc/${ro.boot.bootdevice}/by-name/persist
    mount ext4 /dev/block/platform/soc/${ro.boot.bootdevice}/by-name/persist /mnt/vendor/persist  nosuid nodev noatime barrier=1
    restorecon_recursive --force /mnt/vendor/persist

on early-fs
    start vold

on fs && property:ro.build.user=android-build
    wait /dev/block/platform/soc/${ro.boot.bootdevice}
    symlink /dev/block/platform/soc/${ro.boot.bootdevice} /dev/block/bootdevice
    mount_all /vendor/etc/fstab.qcom
    swapon_all /vendor/etc/fstab.qcom

on fs
    wait /dev/block/platform/soc/${ro.boot.bootdevice}
    symlink /dev/block/platform/soc/${ro.boot.bootdevice} /dev/block/bootdevice

    mount_all /vendor/etc/fstab.qcom
    swapon_all /vendor/etc/fstab.qcom

    chown root system /mnt/vendor/persist
    #chmod 0771 /mnt/vendor/persist

    # Keeping following partitions outside fstab file. As user may not have
    # these partition flashed on the device. Failure to mount any partition in fstab file
    # results in failure to launch late-start class.

    wait /dev/block/platform/soc/${ro.boot.bootdevice}/by-name/persist
    mount ext4 /dev/block/bootdevice/by-name/persist /mnt/vendor/persist nosuid nodev noatime barrier=1
    mkdir /mnt/vendor/persist/data 0700 system system
    mkdir /mnt/vendor/persist/bms 0700 root system
    mkdir /mnt/vendor/persist/time/ 0700 system system
    restorecon_recursive --force /mnt/vendor/persist
    chmod 0771 /mnt/vendor/persist
    write /sys/kernel/boot_adsp/boot 1


#AutoScan
    chmod 0666 /dev/input/event5
    chown system system /sys/class/input/event1/device/LONGDISTANCEPROX/prox_scan_start
    chown system system /sys/class/input/event1/device/LONGDISTANCEPROX/prox_scan_stop
    chown system system /sys/class/input/event3/device/LONGDISTANCEPROX/prox_scan_start
    chown system system /sys/class/input/event3/device/LONGDISTANCEPROX/prox_scan_stop
    chown system system /sys/class/input/event4/device/LONGDISTANCEPROX/prox_scan_start
    chown system system /sys/class/input/event4/device/LONGDISTANCEPROX/prox_scan_stop
    chown system system /sys/class/input/event5/device/LONGDISTANCEPROX/prox_scan_start
    chown system system /sys/class/input/event5/device/LONGDISTANCEPROX/prox_scan_stop

########################################################################
# change mode for VNCL4200(Frozone) and ISL29021(CC600,5")
   chmod 0666 /sys/class/input/event3/device/LONGDISTANCEPROX/prox_enable
   chmod 0666 /sys/class/input/event3/device/LONGDISTANCEPROX/prox_set_delay_ms
   chmod 0666 /sys/class/input/event3/device/LONGDISTANCEPROX/prox_pollrate_ms
   chmod 0666 /sys/class/input/event3/device/LONGDISTANCEPROX/prox_do_flush
   chmod 0666 /sys/class/input/event3/device/LONGDISTANCEPROX/prox_proxTrigState
   ##auto-leveling service will require this
   chmod 0666 /sys/class/input/event3/device/LONGDISTANCEPROX/prox_setThreNear
   chmod 0666 /sys/class/input/event3/device/LONGDISTANCEPROX/prox_setThreFar
   chmod 0644 /persist/vcnl4200_calFile.txt

   chmod 0666 /sys/class/input/event1/device/LONGDISTANCEPROX/prox_enable
   chmod 0666 /sys/class/input/event1/device/LONGDISTANCEPROX/prox_set_delay_ms
   chmod 0666 /sys/class/input/event1/device/LONGDISTANCEPROX/prox_pollrate_ms
   chmod 0666 /sys/class/input/event1/device/LONGDISTANCEPROX/prox_do_flush
   chmod 0666 /sys/class/input/event1/device/LONGDISTANCEPROX/prox_proxTrigState
    ##auto-leveling service will require this
   chmod 0666 /sys/class/input/event1/device/LONGDISTANCEPROX/prox_setThreNear
   chmod 0666 /sys/class/input/event1/device/LONGDISTANCEPROX/prox_setThreFar

# change mode for HALL Sensor(Frozone)
   chmod 0666 /sys/class/input/event4/device/hallholster/hall_enable
   chmod 0666 /sys/class/input/event4/device/hallholster/hall_set_delay_ms
   chmod 0666 /sys/class/input/event4/device/hallholster/hall_pollrate_ms
   chmod 0666 /sys/class/input/event4/device/hallholster/hall_do_flush

# change mode for ISL29021(CC6000,10")
   chmod 0666 /sys/class/input/event2/device/LONGDISTANCEPROX/prox_enable
   chmod 0666 /sys/class/input/event2/device/LONGDISTANCEPROX/prox_set_delay_ms
   chmod 0666 /sys/class/input/event2/device/LONGDISTANCEPROX/prox_pollrate_ms
   chmod 0666 /sys/class/input/event2/device/LONGDISTANCEPROX/prox_do_flush
   chmod 0666 /sys/class/input/event2/device/LONGDISTANCEPROX/prox_proxTrigState
   ##auto-leveling service will require this
   chmod 0666 /sys/class/input/event2/device/LONGDISTANCEPROX/prox_setThreNear
   chmod 0666 /sys/class/input/event2/device/LONGDISTANCEPROX/prox_setThreFar
   chmod 0664 /persist/isl29021_calFile.txt
   chown system system /persist/isl29021_calFile.txt

# change mode for ISL29501(Raven)
   chmod 0666 /sys/class/input/event4/device/LONGDISTANCEPROX/prox_enable
   chmod 0666 /sys/class/input/event4/device/LONGDISTANCEPROX/prox_set_delay_ms
   chmod 0666 /sys/class/input/event4/device/LONGDISTANCEPROX/prox_pollrate_ms
   chmod 0666 /sys/class/input/event4/device/LONGDISTANCEPROX/prox_do_flush
   ###For R branch
   chmod 0666 /sys/class/input/event5/device/LONGDISTANCEPROX/prox_enable
   chmod 0666 /sys/class/input/event5/device/LONGDISTANCEPROX/prox_set_delay_ms
   chmod 0666 /sys/class/input/event5/device/LONGDISTANCEPROX/prox_pollrate_ms
   chmod 0666 /sys/class/input/event5/device/LONGDISTANCEPROX/prox_do_flush
   ###ProxCalTool require this###
   chmod 0666 /sys/class/input/event4/device/LONGDISTANCEPROX/cal_distance
   chmod 0666 /sys/class/input/event4/device/LONGDISTANCEPROX/calibrate
   chmod 0666 /sys/class/input/event4/device/LONGDISTANCEPROX/distance
   chmod 0666 /sys/class/input/event4/device/LONGDISTANCEPROX/do_cal
   chmod 0666 /sys/class/input/event4/device/LONGDISTANCEPROX/dump_proxdata
   chmod 0666 /sys/class/input/event4/device/LONGDISTANCEPROX/dump_proxdata_single
   chmod 0666 /sys/class/input/event4/device/LONGDISTANCEPROX/dump_register
   chmod 0666 /sys/class/input/event4/device/LONGDISTANCEPROX/get_calfile_data
   chmod 0666 /sys/class/input/event4/device/LONGDISTANCEPROX/get_proxdata_count
   chmod 0666 /sys/class/input/event4/device/LONGDISTANCEPROX/ir_current
   chmod 0666 /sys/class/input/event4/device/LONGDISTANCEPROX/persistence
   chmod 0666 /sys/class/input/event4/device/LONGDISTANCEPROX/proxht
   chmod 0666 /sys/class/input/event4/device/LONGDISTANCEPROX/proxlt
   chmod 0666 /sys/class/input/event4/device/LONGDISTANCEPROX/set_cache_proxdata
   chmod 0666 /sys/class/input/event4/device/LONGDISTANCEPROX/set_cal
   chmod 0666 /sys/class/input/event4/device/LONGDISTANCEPROX/set_register
   chmod 0666 /sys/class/input/event4/device/LONGDISTANCEPROX/sleep_time
   ##R Branch use below event node ##
   chmod 0666 /sys/class/input/event3/device/LONGDISTANCEPROX/cal_distance
   chmod 0666 /sys/class/input/event3/device/LONGDISTANCEPROX/calibrate
   chmod 0666 /sys/class/input/event3/device/LONGDISTANCEPROX/distance
   chmod 0666 /sys/class/input/event3/device/LONGDISTANCEPROX/do_cal
   chmod 0666 /sys/class/input/event3/device/LONGDISTANCEPROX/dump_proxdata
   chmod 0666 /sys/class/input/event3/device/LONGDISTANCEPROX/dump_proxdata_single
   chmod 0666 /sys/class/input/event3/device/LONGDISTANCEPROX/dump_register
   chmod 0666 /sys/class/input/event3/device/LONGDISTANCEPROX/get_calfile_data
   chmod 0666 /sys/class/input/event3/device/LONGDISTANCEPROX/get_proxdata_count
   chmod 0666 /sys/class/input/event3/device/LONGDISTANCEPROX/ir_current
   chmod 0666 /sys/class/input/event3/device/LONGDISTANCEPROX/persistence
   chmod 0666 /sys/class/input/event3/device/LONGDISTANCEPROX/proxht
   chmod 0666 /sys/class/input/event3/device/LONGDISTANCEPROX/proxlt
   chmod 0666 /sys/class/input/event3/device/LONGDISTANCEPROX/set_cache_proxdata
   chmod 0666 /sys/class/input/event3/device/LONGDISTANCEPROX/set_cal
   chmod 0666 /sys/class/input/event3/device/LONGDISTANCEPROX/set_register
   chmod 0666 /sys/class/input/event3/device/LONGDISTANCEPROX/sleep_time

   chmod 0666 /sys/class/input/event5/device/LONGDISTANCEPROX/cal_distance
   chmod 0666 /sys/class/input/event5/device/LONGDISTANCEPROX/calibrate
   chmod 0666 /sys/class/input/event5/device/LONGDISTANCEPROX/distance
   chmod 0666 /sys/class/input/event5/device/LONGDISTANCEPROX/do_cal
   chmod 0666 /sys/class/input/event5/device/LONGDISTANCEPROX/dump_proxdata
   chmod 0666 /sys/class/input/event5/device/LONGDISTANCEPROX/dump_proxdata_single
   chmod 0666 /sys/class/input/event5/device/LONGDISTANCEPROX/dump_register
   chmod 0666 /sys/class/input/event5/device/LONGDISTANCEPROX/get_calfile_data
   chmod 0666 /sys/class/input/event5/device/LONGDISTANCEPROX/get_proxdata_count
   chmod 0666 /sys/class/input/event5/device/LONGDISTANCEPROX/ir_current
   chmod 0666 /sys/class/input/event5/device/LONGDISTANCEPROX/persistence
   chmod 0666 /sys/class/input/event5/device/LONGDISTANCEPROX/proxht
   chmod 0666 /sys/class/input/event5/device/LONGDISTANCEPROX/proxlt
   chmod 0666 /sys/class/input/event5/device/LONGDISTANCEPROX/set_cache_proxdata
   chmod 0666 /sys/class/input/event5/device/LONGDISTANCEPROX/set_cal
   chmod 0666 /sys/class/input/event5/device/LONGDISTANCEPROX/set_register
   chmod 0666 /sys/class/input/event5/device/LONGDISTANCEPROX/sleep_time

   chmod 0644 /persist/isl29501_calibration_done.txt
   chmod 0644 /persist/isl29501_defaults.txt

# change mode for HALL Sensor(Raven)
   chmod 0666 /sys/class/input/event5/device/hallholster/hall_enable
   chmod 0666 /sys/class/input/event5/device/hallholster/hall_set_delay_ms
   chmod 0666 /sys/class/input/event5/device/hallholster/hall_pollrate_ms
   chmod 0666 /sys/class/input/event5/device/hallholster/hall_do_flush
   ##R Branch : hall sensor at event2 node ##
   chmod 0666 /sys/class/input/event2/device/hallholster/hall_enable
   chmod 0666 /sys/class/input/event2/device/hallholster/hall_set_delay_ms
   chmod 0666 /sys/class/input/event2/device/hallholster/hall_pollrate_ms
   chmod 0666 /sys/class/input/event2/device/hallholster/hall_do_flush

# key backlight pwm
   chown system system /sys/zebra-keylight/
   chown system system /sys/zebra-keylight/0
   chown system system /sys/zebra-keylight/0/keypad_avail_duration_hz
   chown system system /sys/zebra-keylight/0/keypad_avail_freq_hz
   chown system system /sys/zebra-keylight/0/keypad_duty_cycle_ns
   chown system system /sys/zebra-keylight/0/keypad_level_maximum
   chown system system /sys/zebra-keylight/0/keypad_level_minimum
   chown system system /sys/zebra-keylight/0/keypad_period_ns
   chown system system /sys/zebra-keylight/0/keypad_pwm_on
   chown system system /sys/zebra-keylight/0/keypad_time_ms
   chmod 0644 /sys/zebra-keylight/0/keypad_duty_cycle_ns
   chmod 0644 /sys/zebra-keylight/0/keypad_period_ns
   chmod 0644 /sys/zebra-keylight/0/keypad_pwm_on
   chmod 0644 /sys/zebra-keylight/0/keypad_time_ms

# key backlight pwm
   chown system system /sys/zebra-keylight/
   chown system system /sys/zebra-keylight/0
   chown system system /sys/zebra-keylight/0/keypad_avail_duration_hz
   chown system system /sys/zebra-keylight/0/keypad_avail_freq_hz
   chown system system /sys/zebra-keylight/0/keypad_duty_cycle_ns
   chown system system /sys/zebra-keylight/0/keypad_level_maximum
   chown system system /sys/zebra-keylight/0/keypad_level_minimum
   chown system system /sys/zebra-keylight/0/keypad_period_ns
   chown system system /sys/zebra-keylight/0/keypad_pwm_on
   chown system system /sys/zebra-keylight/0/keypad_time_ms
   chmod 0644 /sys/zebra-keylight/0/keypad_duty_cycle_ns
   chmod 0644 /sys/zebra-keylight/0/keypad_period_ns
   chmod 0644 /sys/zebra-keylight/0/keypad_pwm_on
   chmod 0644 /sys/zebra-keylight/0/keypad_time_ms

   # Switch owner to system for Scanner FW Progress state
   chown system system /sys/symbol-typec/scanner_fw_inprogress

########################################################################

 #Animation Partition
   wait /dev/block/bootdevice/by-name/animation
   mount ext4 /dev/block/bootdevice/by-name/animation  /animation   ro context=u:object_r:animation_file:s0

on property:ro.wlan.reg_device_id=*
    wait /data/vendor/wifi
    start vendor.fusionloader

on post-fs
    write /dev/ipa 1
# Permissions for ttyMSM1 port
    chmod 0666 /dev/ttyMSM1
    chown system system /dev/ttyMSM1
    chown system system /dev/cradledrv
    chmod 0666 /dev/cradledrv
    chown system system /sys/symbol-cradle
    chown system system /dev/cradle_dev
    chmod 0666 /dev/cradle_dev

on init
    # write /sys/module/qpnp_rtc/parameters/poweron_alarm 1
    start hw_config
    start uuid

on load_persist_props_action && property:vendor.display.lcd_density=*
   start display_hw_config

on property:persist.sys.device.rotation=*
   start display_hw_config_rotation

on property:ro.boot.symbol.btmacaddr=*
   setprop ro.vendor.boot.btmacaddr ${ro.boot.symbol.btmacaddr}
   setprop ro.vendor.bt.boot.macaddr ${ro.boot.symbol.btmacaddr}

on property:ro.boot.wlan.reg_device_id=*
   setprop ro.wlan.reg_device_id ${ro.boot.wlan.reg_device_id}

on property:ro.boot.device.partnumber=*
   setprop ro.config.device.partnumber ${ro.boot.device.partnumber}

on property:ro.boot.device.regulatory=*
   setprop ro.config.device.regulatory ${ro.boot.device.regulatory}

on post-fs-data
    mkdir /data/vendor/tombstones/modem 0771 system system
    mkdir /data/vendor/tombstones/lpass 0771 system system
    mkdir /data/vendor/tombstones/wcnss 0771 system system
    mkdir /data/vendor/tombstones/dsps 0771 system system
    mkdir /data/vendor/hbtp 0750 system system
    mkdir /persist/qti_fp 0700 system system
    mkdir /data/vendor/misc/seemp 0700 system system
    mkdir /data/vendor/device 0700 system system
    mkdir /data/vendor/tloc 0700 system drmrpc

# OS Update
    mkdir /data/tmp 0771 system system
    mkdir /data/tmp/public 0777 system system

#Load fusionwl driver
    start vendor.fusionloader_init

# Switch owner to system for usb host and peripheral mode
    chown system system /sys/devices/platform/soc/a800000.ssusb/mode
    chown system system /sys/devices/platform/soc/c200000.hsusb/mode

# Enterprise nfc config folder
    mkdir /data/vendor/enfc 0700 nfc nfc

# Switch owner to system for usb typec simu mode
    chown system system /sys/symbol-typec/typec_simu_none

# Switch owner to system for usb_physically_removed
    chown system system /sys/symbol_usb_phy_removed/usb_physically_removed

# Device settings for keyremap
    chown system system /sys/symbol-keypad/actions/selectkey

#Switch owner to system for usb Back IO
    chown system system /sys/symbol-IsBackIo/back_io_Acc

#WakeupSource
    mkdir /data/vendor/keywakeup 0760 system system
    chown system system /dev/wakeup
    chmod 0666 /dev/wakeup

#permission for sensor sns.reg
    chown system root /mnt/vendor/persist/sensors/sns.reg
    chmod 0644 /mnt/vendor/persist/sensors/sns.reg

# change owner to the system for irda
    chown system system /sys/symbol_irda/irdabaudrate
    chmod 0666 /sys/symbol_irda/irdabaudrate

# switch owner to the system for SAM
    chown system system /sys/symbol-sam

# Permissions for SAM device
    chown system system /dev/sam-bridge
    chmod 0666 /dev/sam-bridge

# Ocelot Ethernet
    chown system system /sys/bus/usb/devices/1-1.5/power/control
    chmod 0664 /sys/bus/usb/devices/1-1.5/power/control

# switch owner to the system for ProductSpecificFeatures (PSF)
    chown system system /sys/zebra-ec/antenna_switchs/0/value
    chown system system /sys/zebra-ec/antenna_switchs/1/value
    chown system system /sys/zebra-ec/blueled
    chown system system /sys/zebra-ec/ignition/config
    chown system system /sys/zebra-ec/ignition/delay
    chown system system /sys/zebra-ec/powerrails/0/value
    chown system system /sys/zebra-ec/powerrails/1/value
    chown system system /sys/zebra-ec/powerrails/2/value

# switch owner to the system for EC
    chown system system /sys/zebra-ec/dev_pwr

# Battery Swap
    chown system system /sys/battery_swap/enabled
    chown system system /sys/battery_swap/enable_buck_boost
    chown system system /sys/battery_swap/super_cap_ready
    chown system system /sys/battery_swap/rtc_poweron_alarm
    chown system system /sys/battery_swap/batteryswap_inprogress
    chown system system /sys/class/leds/blue/breath
    chown system system /sys/devices/platform/soc/c178000.i2c/i2c-4/4-004b/touch_screen_mode
    chown system system /sys/devices/platform/soc/c178000.i2c/i2c-4/4-0034/tca8418_keypad_mode
    chown system system /sys/devices/platform/soc/c178000.i2c/i2c-4/4-0024/cyttsp5_ts_mode
    chown system system /sys/devices/platform/soc/soc:helios_gpio_keys/disabled_keys
    chown system system /sys/devices/platform/soc/soc:helios_gpio_keys/keys
    chown system system /sys/devices/soc/soc:gpio-mpa-keys/mpa_gpio_mode
    chown system system /sys/devices/soc/c178000.i2c/i2c-4/4-0038/touch_screen_mode

# BSPA-134268 [Ocelot][Battery] [Android Q] Notify (blue) led is not controlled correctly by led service
# switch owner to the system for EC LED
    chown system system /sys/zebra-ec/led_ntfy

# Touch
    chown system root /sys/devices/platform/soc/c178000.i2c/i2c-4/4-004b/update_fw
    chown system root /sys/devices/platform/soc/c178000.i2c/i2c-4/4-004b/cfg_version
    chown system root /sys/devices/platform/soc/c178000.i2c/i2c-4/4-004a/update_fw
    chown system root /sys/devices/platform/soc/c178000.i2c/i2c-4/4-004a/cfg_version
    chown system root /sys/devices/platform/soc/c178000.i2c/i2c-4/4-0024/ic_ver
    chown system root /sys/bus/i2c/devices/4-002a/firmware_version
    chown system root /sys/devices/platform/soc/c178000.i2c/i2c-4/4-0038/fts_fw_version

# Badger Touch
    chown system system /sys/devices/soc/c178000.i2c/i2c-4/4-0038/fts_glove_mode

on early-boot
    chown system system /mnt/vendor/persist/sensors
    chown system system /mnt/vendor/persist/sensors/sns.reg
    chown system system /mnt/vendor/persist/sensors/sensors_settings
    chmod 0664 /mnt/vendor/persist/sensors/sensors_settings

on boot
    start rmt_storage
    start rfs_access
    write /dev/cpuset/top-app/cpus 0-7
    write /dev/cpuset/foreground/cpus 0-7
    write /dev/cpuset/foreground/boost/cpus 0-7
    write /dev/cpuset/background/cpus 0-7
    write /dev/cpuset/system-background/cpus 0-7
    ####Regionalization config and prop files####
    chmod 0644 /persist/speccfg/spec
    chmod 0644 /persist/speccfg/devicetype
    chmod 0644 /persist/speccfg/mbnversion
    chmod 0644 /persist/speccfg/.not_triggered
    chmod 0644 /persist/speccfg/vendor_ro.prop
    chmod 0644 /persist/speccfg/vendor_persist.prop
    chmod 0644 /persist/speccfg/submask
    chmod 0644 /persist/speccfg/partition
    chown system system /persist/speccfg/spec
    chown system system /persist/speccfg/devicetype
    chown system system /persist/speccfg/mbnversion
    chown system system /persist/speccfg/.not_triggered
    chown system system /persist/speccfg/vendor_ro.prop
    chown system system /persist/speccfg/vendor_persist.prop
    chown system system /persist/speccfg/submask
    chown system system /persist/speccfg/partition

# rfid
   chown system system /sys/symbol-rfid/rfid_gpio

#Remote Key
   chown system system /sys/rkey/rk_reg
   chown system system /sys/rkey/rk_unreg
   chown system system /dev/rkey
   chmod 0666 /dev/rkey

# LED system owner for led-gpio node for scan red and green
    chown system system /sys/class/backlight/lcd-bl/brightness

# LED system owner for led-qpnp node
    chown system system /sys/class/leds/red/blink
    chown system system /sys/class/leds/green/blink
    chown system system /sys/class/leds/blue/blink
    chown system system /sys/class/leds/red/duty_pcts
    chown system system /sys/class/leds/green/duty_pcts
    chown system system /sys/class/leds/blue/duty_pcts
    chown system system /sys/class/leds/red/ramp_step_ms
    chown system system /sys/class/leds/green/ramp_step_ms
    chown system system /sys/class/leds/blue/ramp_step_ms
    chown system system /sys/class/leds/red/start_idx
    chown system system /sys/class/leds/green/start_idx
    chown system system /sys/class/leds/blue/start_idx
    chown system system /sys/class/leds/red/rgb_mode
    chown system system /sys/class/leds/green/rgb_mode
    chown system system /sys/class/leds/blue/rgb_mode
    chown system system /sys/class/leds/red/trigger
    chown system system /sys/class/leds/green/trigger
    chown system system /sys/class/leds/blue/trigger
    chown system system /sys/class/leds/red/pattern
    chown system system /sys/class/leds/red/loop_mode
    chown system system /sys/class/leds/green/loop_mode
    chown system system /sys/class/leds/blue/loop_mode
    chown system system /sys/class/leds/red/hotswap_mode
    chown system system /sys/class/leds/green/hotswap_mode
    chown system system /sys/class/leds/blue/hotswap_mode

    chown system system /sys/class/pwm/pwmchip0/device/lpg1_duty_pcts
    chown system system /sys/class/pwm/pwmchip0/device/lpg1_lo_index
    chown system system /sys/class/pwm/pwmchip0/device/lpg1_ramp_step_ms
    chown system system /sys/class/pwm/pwmchip0/device/lpg2_duty_pcts
    chown system system /sys/class/pwm/pwmchip0/device/lpg2_lo_index
    chown system system /sys/class/pwm/pwmchip0/device/lpg2_ramp_step_ms
    chown system system /sys/class/pwm/pwmchip0/device/lpg3_duty_pcts
    chown system system /sys/class/pwm/pwmchip0/device/lpg3_lo_index
    chown system system /sys/class/pwm/pwmchip0/device/lpg3_ramp_step_ms

# LED system owner for led-gpio node for scan red and green
    chown system system /sys/class/leds/scan_led_drv_g/brightness
    chown system system /sys/class/leds/scan_led_drv_r/brightness
    chmod 0664 /sys/class/leds/scan_led_drv_r/brightness
    chown system system /sys/devices/soc/soc:helios_gpio_keys/disabled_keys
    chown system system /sys/class/leds/keyboard_led/brightness
    chown system system /sys/class/backlight/lcd-bl/brightness

# LED system owner for led-gpio node of scan RGB
    chown system system /sys/class/leds/scan_led_drv_r/trigger
    chown system system /sys/class/leds/scan_led_drv_r/delay_off
    chown system system /sys/class/leds/scan_led_drv_r/delay_on
    chown system system /sys/class/leds/scan_led_drv_r/timer_on

    chown system system /sys/class/leds/scan_led_drv_g/trigger
    chown system system /sys/class/leds/scan_led_drv_g/delay_off
    chown system system /sys/class/leds/scan_led_drv_g/delay_on
    chown system system /sys/class/leds/scan_led_drv_g/timer_on

    chown system system /sys/class/leds/scan_led_drv_b/trigger
    chown system system /sys/class/leds/scan_led_drv_b/delay_off
    chown system system /sys/class/leds/scan_led_drv_b/delay_on
    chown system system /sys/class/leds/scan_led_drv_b/timer_on

#Create folder dump yuv images while debugging
    mkdir /data/vendor/camera 0770 camera camera

#Load WLAN driver
#   insmod /vendor/lib/modules/qca_cld3_wlan.ko

#USB controller configuration
    setprop vendor.usb.rndis.func.name "rndis_bam"
    setprop vendor.usb.rmnet.func.name "rmnet_bam"
    setprop vendor.usb.rmnet.inst.name "rmnet"
    setprop vendor.usb.dpl.inst.name "dpl"
    write /sys/module/usb_f_qcrndis/parameters/rndis_dl_max_xfer_size 15916
    setprop sys.usb.configfs 1
 # support enable for one handed mode
    setprop ro.support_one_handed_mode true
 # change mode for Heater (Galactus)
    chown system system /sys/zebra-heaters/
    chown system system /sys/zebra-heaters/0/
    chown system system /sys/zebra-heaters/0/dutyCycle
    chown system system /sys/zebra-heaters/0/enabled
    chown system system /sys/zebra-heaters/0/on
    chown system system /sys/zebra-heaters/0/rampTime
    chown system system /sys/zebra-heaters/0/timeout
    chown system system /sys/zebra-heaters/params/enabled
    chown system system /sys/zebra-heaters/params/heater_enabled

    chmod 0664 /sys/zebra-heaters/0/dutyCycle
    chmod 0664 /sys/zebra-heaters/0/enabled
    chmod 0664 /sys/zebra-heaters/0/on
    chmod 0664 /sys/zebra-heaters/0/rampTime
    chmod 0664 /sys/zebra-heaters/0/timeout
    chmod 0664 /sys/zebra-heaters/params/enabled
    chmod 0664 /sys/zebra-heaters/params/heater_enabled

    chown system system /sys/zebra-temperature/
    chown system system /sys/zebra-temperature/2
    chown system system /sys/zebra-temperature/3
    chown system system /sys/zebra-temperature/4
    chown system system /sys/zebra-temperature/5
    chown system system /sys/zebra-temperature/6
    chown system system /sys/zebra-temperature/7
    chown system system /sys/zebra-temperature/2/name
    chown system system /sys/zebra-temperature/2/temp
    chown system system /sys/zebra-temperature/3/name
    chown system system /sys/zebra-temperature/3/temp
    chown system system /sys/zebra-temperature/4/name
    chown system system /sys/zebra-temperature/4/temp
    chown system system /sys/zebra-temperature/5/name
    chown system system /sys/zebra-temperature/5/temp
    chown system system /sys/zebra-temperature/6/name
    chown system system /sys/zebra-temperature/6/temp
    chown system system /sys/zebra-temperature/7/name
    chown system system /sys/zebra-temperature/7/temp

    chmod 0444 /sys/zebra-temperature/2/name
    chmod 0444 /sys/zebra-temperature/2/temp
    chmod 0444 /sys/zebra-temperature/3/name
    chmod 0444 /sys/zebra-temperature/3/temp
    chmod 0444 /sys/zebra-temperature/4/name
    chmod 0444 /sys/zebra-temperature/4/temp
    chmod 0444 /sys/zebra-temperature/5/name
    chmod 0444 /sys/zebra-temperature/5/temp
    chmod 0444 /sys/zebra-temperature/6/name
    chmod 0444 /sys/zebra-temperature/6/temp
    chmod 0444 /sys/zebra-temperature/7/name
    chmod 0444 /sys/zebra-temperature/7/temp

    chown system system /sys/zebra-humidity/
    chown system system /sys/zebra-humidity/0/
    chown system system /sys/zebra-humidity/0/name
    chown system system /sys/zebra-humidity/0/temp
    chown system system /sys/zebra-humidity/0/humidity
    chown system system /sys/zebra-humidity/1/
    chown system system /sys/zebra-humidity/1/name
    chown system system /sys/zebra-humidity/1/temp
    chown system system /sys/zebra-humidity/1/humidity

    chmod 0444 /sys/zebra-humidity/0/name
    chmod 0444 /sys/zebra-humidity/0/temp
    chmod 0444 /sys/zebra-humidity/0/humidity
    chmod 0444 /sys/zebra-humidity/1/name
    chmod 0444 /sys/zebra-humidity/1/temp
    chmod 0444 /sys/zebra-humidity/1/humidity

    # Switch owner to the system for heaters (Optimus)
    chown system system /sys/heater/
    chown system system /sys/heater/0/
    chown system system /sys/heater/0/enable
    chown system system /sys/heater/0/name
    chown system system /sys/heater/0/status
    chown system system /sys/heater/0/test
    chown system system /sys/heater/0/threshold-off
    chown system system /sys/heater/0/threshold-on
    chown system system /sys/heater/1/
    chown system system /sys/heater/1/enable
    chown system system /sys/heater/1/name
    chown system system /sys/heater/1/status
    chown system system /sys/heater/1/test
    chown system system /sys/heater/1/threshold-off
    chown system system /sys/heater/1/threshold-on
    chown system system /sys/heater/2/
    chown system system /sys/heater/2/enable
    chown system system /sys/heater/2/name
    chown system system /sys/heater/2/status
    chown system system /sys/heater/2/test
    chown system system /sys/heater/2/threshold-off
    chown system system /sys/heater/2/threshold-on
    chown system system /sys/heater/3/
    chown system system /sys/heater/3/enable
    chown system system /sys/heater/3/name
    chown system system /sys/heater/3/status
    chown system system /sys/heater/3/test
    chown system system /sys/heater/3/threshold-off
    chown system system /sys/heater/3/threshold-on
    chown system system /sys/heater/4/
    chown system system /sys/heater/4/enable
    chown system system /sys/heater/4/name
    chown system system /sys/heater/4/status
    chown system system /sys/heater/4/test
    chown system system /sys/heater/4/threshold-off
    chown system system /sys/heater/4/threshold-on

#WTIoConnector
    chown system system /sys/devices/platform/soc/soc:wt-iomux/extpoweravail
    chown system system /sys/devices/platform/soc/soc:wt-iomux/leftconfigure
    chown system system /sys/devices/platform/soc/soc:wt-iomux/rightconfigure
    chown system system /sys/devices/platform/soc/soc:wt-iomux/scannerport
    chown system system /sys/devices/platform/soc/soc:wt-iomux/powersave
    chown system system /sys/devices/platform/soc/soc:wt-iomux/timedgpio

    chmod 0664 /sys/devices/platform/soc/soc:wt-iomux/extpoweravail
    chmod 0664 /sys/devices/platform/soc/soc:wt-iomux/leftconfigure
    chmod 0664 /sys/devices/platform/soc/soc:wt-iomux/rightconfigure
    chmod 0664 /sys/devices/platform/soc/soc:wt-iomux/scannerport
    chmod 0664 /sys/devices/platform/soc/soc:wt-iomux/powersave
    chmod 0664 /sys/devices/platform/soc/soc:wt-iomux/timedgpio

    chown system system /dev/ttyHS2
    chmod 0660 /dev/ttyHS2

    chown system system /sys/vspoc/enable
    chown system system /sys/vspoc/vspoc_reset
    chown system system /sys/vspoc/vspoc_usb_switch
    chown system system /sys/vspoc/vspoc_5p0
    chown system system /sys/vspoc/enable_charging
    chown system system /sys/vspoc/battflags
    chown system system /sys/zback_scanner/vbus_enable
    chown system system /sys/zback_scanner/usb_devname

#Peripheral manager
service vendor.per_mgr /system/vendor/bin/pm-service
    class core
    user system
    group system
    ioprio rt 4

service vendor.per_proxy /system/vendor/bin/pm-proxy
    class core
    user system
    group system
    disabled

on property:init.svc.vendor.per_mgr=running
    start vendor.per_proxy

on property:sys.shutdown.requested=*
    stop vendor.per_proxy

# allow switching touch cfg
    chown system system /sys/bus/i2c/devices/4-0024/switch_cfg

# HW-Config
service hw_config /system/vendor/bin/hw_config
    class core
    user root
    group root
    oneshot

#Display HW-Config
service display_hw_config /system/vendor/bin/hw_config display_props
    class core
    user root
    group root
    oneshot

#Display HW-Config
service display_hw_config_rotation /system/vendor/bin/hw_config display_props ${persist.sys.device.rotation}
    class core
    user root
    group root
    oneshot
    disabled

#UUID
service uuid /system/vendor/bin/uuid
    class core
    user root
    group root
    oneshot

