# USB compositions
on property:sys.usb.config=rndis,none && property:sys.usb.configfs=1 && property:ro.vendor.manufacturer="Zebra Technologies"
    write /config/usb_gadget/g1/idVendor 0x05e0
    write /config/usb_gadget/g1/idProduct 0x2105

on property:sys.usb.ffs.ready=1 && property:sys.usb.config=rndis,none,adb && property:sys.usb.configfs=1 && property:ro.vendor.manufacturer="Zebra Technologies"
    write /config/usb_gadget/g1/idVendor 0x05e0
    write /config/usb_gadget/g1/idProduct 0x2102

on property:sys.usb.config=mtp && property:sys.usb.configfs=1 && property:ro.vendor.manufacturer="Zebra Technologies"
    write /config/usb_gadget/g1/idVendor 0x05e0
    write /config/usb_gadget/g1/idProduct 0x2104

on property:sys.usb.config=mtp,adb && property:sys.usb.configfs=1 && property:ro.vendor.manufacturer="Zebra Technologies"
    write /config/usb_gadget/g1/idVendor 0x05e0
    write /config/usb_gadget/g1/idProduct 0x2101

on property:sys.usb.config=adb && property:sys.usb.configfs=1 && property:ro.vendor.manufacturer="Zebra Technologies"
    write /config/usb_gadget/g1/idVendor 0x05e0
    write /config/usb_gadget/g1/idProduct 0x2106

on property:sys.usb.config=ptp && property:sys.usb.configfs=1 && property:ro.vendor.manufacturer="Zebra Technologies"
    write /config/usb_gadget/g1/idVendor 0x05e0
    write /config/usb_gadget/g1/idProduct 0x2109

on property:sys.usb.config=ptp,adb && property:sys.usb.configfs=1 && property:ro.vendor.manufacturer="Zebra Technologies"
    write /config/usb_gadget/g1/idVendor 0x05e0
    write /config/usb_gadget/g1/idProduct 0x2108
