#odm starts

on init
    chown root root /odm
    restorecon_recursive /odm/
    restorecon_recursive --force /odm
    chmod 0755 /odm/firmware
    chmod 0755 /odm/etc
    chmod 0755 /odm/etc/vintf
    chmod 0755 /odm/etc/permissions
    chmod 0644 /odm/etc/vintf/manifest.xml
    chmod 0644 /odm/etc/permissions/unavailable_features.xml
    chmod 0644 /odm/etc/media_profiles_V1_0.xml
    chmod 0644 /odm/etc/odmconfig.xml
    chmod 0644 /odm/etc/media_codecs.xml
    chmod 0644 /odm/etc/media_codecs_google_audio.xml
    chmod 0644 /odm/fbe.ini
    chmod 0644 /odm/osu_cc.ini
    chmod 0644 /odm/etc/media_codecs_google_telephony.xml
    chmod 0644 /odm/etc/media_codecs_google_video.xml
    chmod 0644 /odm/etc/media_codecs_performance.xml
    chmod 0644 /odm/etc/media_codecs_vendor_audio.xml

on init && property:ro.boot.fbe=1
    rm /odm/fde_fbe.ini
    start copy_odm

on property:ro.vendor.hwconfig.completed=true
    rm /odm/fde_fbe.ini
    start copy_odm

on property:sys.boot_completed=1
   umount /odm
   mount ext4 /dev/block/bootdevice/by-name/factory /odm ro nosuid nodev noatime barrier=1

on property:ro.vendor.odm_restart=1
    chown root root /odm
    chmod 0755 /odm/etc
    chmod 0755 /odm/etc/vintf
    chmod 0755 /odm/etc/permissions
    chmod 0644 /odm/etc/vintf/manifest.xml
    chmod 0644 /odm/etc/permissions/unavailable_features.xml
    chmod 0644 /odm/etc/media_profiles_V1_0.xml
    chmod 0644 /odm/etc/odmconfig.xml
    chmod 0644 /odm/etc/media_codecs.xml
    chmod 0644 /odm/etc/media_codecs_google_audio.xml
    chmod 0644 /odm/etc/media_codecs_google_telephony.xml
    chmod 0644 /odm/etc/media_codecs_google_video.xml
    chmod 0644 /odm/etc/media_codecs_performance.xml
    chmod 0644 /odm/etc/media_codecs_vendor_audio.xml
    chmod 0644 /odm/fbe.ini
    chmod 0644 /odm/osu_cc.ini
    start product_prop

service product_prop /vendor/bin/product_prop
    class core
    user root
    group root
    oneshot
    disabled

service copy_odm /vendor/bin/copy_odm
    class core
    user root
    group root
    oneshot
    disabled
