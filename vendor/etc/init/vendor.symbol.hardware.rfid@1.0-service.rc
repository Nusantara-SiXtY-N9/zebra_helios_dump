service rfid-1-0 /vendor/bin/hw/vendor.symbol.hardware.rfid@1.0-service
    class hal
    user system
    group system

#BSPA-220062: disable unused services for 2GB to reduce the memory usage
on property:sys.boot_completed=1 && property:ro.config.device.memsize=4 && property:ro.config.device.rfid=0
    stop rfid-1-0

#BSPA-227040 [SD660] [TC77 4GB SKU] Failure in Memory Stress Test while running Delivery scenario disable unused services for 3GB to reduce the memory usage
on property:sys.boot_completed=1 && property:ro.config.device.memsize=8 && property:ro.config.device.rfid=0
     stop rfid-1-0
