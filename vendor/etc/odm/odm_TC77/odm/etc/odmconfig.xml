  <!--During OS upgrade this xml will be in use
      1. copy_odm will compare ro.vendor.product with alias name, if it matches with any value the
         first it will return corresponding model name.
      2. Next copy_odm will again scan alias name as ro.vendor.product, if it match any config_name
         and config_value then it will supress model name, rather it will return target name
         eg: ro.vendor.product=TC21PG ->first it will match and return model name as TC21P which is
             equivalent to odm_TC21P.img, Now for 4GB device instead of odm_TC21P, ofm_TC21PH will
             be used, so in next scan it will match with config namd and value and will retun TC21PH
             So instead of copying odm_TC21P content it will copy TC21PH contents. -->
   <setup_odm>
       <prop_value config_name="ro.config.device.memsize" config_value="16">
           <target name="TC21PH">
               <alias>TC21PG</alias>
               <alias>TC21PA</alias>
               <alias>TC21PG_TR</alias>
               <alias>TC21PG_RU</alias>
           </target>
           <target name="TC26PH">
               <alias>TC26PG</alias>
               <alias>TC26PA</alias>
               <alias>TC26PG_TR</alias>
               <alias>TC26PG_RU</alias>
           </target>
       </prop_value>
       <prop_value config_name="ro.config.device.memsize" config_value="8">
           <target name="EC50L">
               <alias>EC50S</alias>
               <alias>EC50SA</alias>
               <alias>EC50S_TR</alias>
               <alias>EC50S_RU</alias>
           </target>
           <target name="EC55L">
               <alias>EC55S</alias>
               <alias>EC55SA</alias>
               <alias>EC55S_TR</alias>
               <alias>EC55S_RU</alias>
           </target>
       </prop_value>
       <prop_value config_name="ro.config.device.memsize" config_value="4">
           <target name="TC21ML">
               <alias>TC21MG</alias>
               <alias>TC21MA</alias>
               <alias>TC21MG_TR</alias>
               <alias>TC21MG_RU</alias>
           </target>
           <target name="TC26ML">
               <alias>TC26MG</alias>
               <alias>TC26MA</alias>
               <alias>TC26MG_RU</alias>
           </target>
           <target name="TC26ML_TR">
               <alias>TC26MG_TR</alias>
           </target>
       </prop_value>
       <prop_value config_name="ro.vendor.product.device" config_value="ET51S">
           <target name="ET51S">
               <alias>ET51</alias>
               <alias>ET51_RU</alias>
           </target>
       </prop_value>
       <prop_value config_name="ro.vendor.product.device" config_value="ET51L">
           <target name="ET51L">
               <alias>ET51</alias>
               <alias>ET51_RU</alias>
           </target>
       </prop_value>
       <prop_value config_name="ro.vendor.product.device" config_value="ET56S">
           <target name="ET56S">
               <alias>ET56</alias>
               <alias>ET56_RU</alias>
           </target>
       </prop_value>
       <prop_value config_name="ro.vendor.product.device" config_value="ET56L">
           <target name="ET56L">
               <alias>ET56C</alias>
               <alias>ET56CA</alias>
               <alias>ET56C_TR</alias>
               <alias>ET56C_RU</alias>
           </target>
       </prop_value>
       <prop_value config_name="ro.config.device.vibrator" config_value="1">
           <target name="MC2200PV">
               <alias>MC2200PA</alias>
               <alias>MC2200PG</alias>
           </target>
           <target name="MC2700PV">
